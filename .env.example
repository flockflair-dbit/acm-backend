# Certificate generation does NOT require these for local testing.

# Optional. Backend port (default 3000)
PORT=3000

# Admin panel password (default: acm-admin)
# ADMIN_PASSWORD=acm-admin
# Optional token signing secret. Defaults to a value derived from ADMIN_PASSWORD.
# ADMIN_SECRET=

# Only needed for auth/student MongoDB routes (not certificates)
# MONGODB_URI=mongodb+srv://USER:PASS@acm-backend.jbgki1q.mongodb.net/?retryWrites=true&w=majority&appName=acm-backend
# MONGODB_USERNAME=
# MONGODB_PASS=
